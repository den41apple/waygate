# Скопируйте в .env и заполните секретами:
#   cp .env.example .env

# Пароль для PostgreSQL внутри compose-стека. Можно сгенерировать через openssl rand -hex 16
POSTGRES_PASSWORD=

# Секрет для подписи session/WS-JWT. Минимум 32 символа.
# openssl rand -hex 24
SECRET_KEY=

# Bootstrap первого админа control-plane'а. При первом старте создаётся юзер
# с этим логином/паролем (is_admin=True). Без них войти в панель невозможно.
WAYGATE_ADMIN_USER=admin
WAYGATE_ADMIN_PASSWORD=

# Хост, на котором будет открываться панель (для CORS)
WAYGATE_HOST=localhost

# Через запятую — origin'ы, которым разрешён доступ к API из браузера
CORS_ORIGINS=http://localhost,http://localhost:5173

# Уровень логирования server-сервиса
LOG_LEVEL=INFO

# URL wheel'а агента — провижионер скачает его на новый сервер.
# Дефолт указывает на den41apple/waygate. Если у тебя свой fork — поправь.
AGENT_WHEEL_URL=https://github.com/den41apple/waygate/releases/latest/download/waygate_agent-py3-none-any.whl
